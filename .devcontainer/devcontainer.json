{
  "name": "ARGUS - ROS 2 Jazzy",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspaces/argus",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/argus,type=bind",
  "remoteUser": "ubuntu",
  "runArgs": [
    "--network=host",
    "--ipc=host"
  ],
  "mounts": [
    "source=/mnt/wslg/.X11-unix,target=/tmp/.X11-unix,type=bind"
  ],
  "containerEnv": {
    "DISPLAY": ":0",
    "QT_QPA_PLATFORM": "xcb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-python.python",
        "ms-vscode.cpptools"
      ]
    }
  }
}